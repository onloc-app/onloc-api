generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Device {
  id         BigInt     @id @default(autoincrement())
  user_id    BigInt
  name       String     @db.VarChar(255)
  icon       String?    @db.VarChar(255)
  can_ring   Boolean    @default(false)
  created_at DateTime   @db.Timestamp(0)
  updated_at DateTime   @db.Timestamp(0)
  user       User       @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "devices_user_id_foreign")
  locations  Location[]

  @@unique([user_id, name], map: "devices_user_id_name_unique")
  @@map("devices")
}

model Location {
  id                BigInt   @id @default(autoincrement())
  device_id         BigInt
  accuracy          Float?
  altitude          Float?
  altitude_accuracy Float?
  latitude          Float
  longitude         Float
  battery           Int?
  created_at        DateTime @db.Timestamp(0)
  updated_at        DateTime @db.Timestamp(0)
  device            Device   @relation(fields: [device_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "locations_device_id_foreign")

  @@map("locations")
}

model Setting {
  id         BigInt   @id @default(autoincrement())
  key        String   @db.VarChar(255)
  value      String   @db.VarChar(255)
  created_at DateTime @db.Timestamp(0)
  updated_at DateTime @db.Timestamp(0)

  @@map("settings")
}

model Preference {
  id         BigInt   @id @default(autoincrement())
  user_id    BigInt
  key        String   @db.VarChar(255)
  value      String   @db.VarChar(255)
  created_at DateTime @db.Timestamp(0)
  updated_at DateTime @db.Timestamp(0)
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "preferences_user_id_foreign")

  @@map("preferences")
}

model User {
  id             BigInt         @id @default(autoincrement())
  username       String         @unique(map: "users_username_unique") @db.VarChar(255)
  password       String         @db.VarChar(255)
  admin          Boolean        @default(false)
  created_at     DateTime       @db.Timestamp(0)
  updated_at     DateTime       @db.Timestamp(0)
  devices        Device[]
  refresh_tokens RefreshToken[]
  preferences    Preference[]
  api_keys       ApiKey[]
  userTiers      UserTier[]

  @@map("users")
}

model RefreshToken {
  id         BigInt   @id @default(autoincrement())
  user_id    BigInt
  token      String   @unique(map: "refresh_tokens_token_unique")
  agent      String?
  created_at DateTime @db.Timestamp(0)
  updated_at DateTime @db.Timestamp(0)
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "refresh_tokens_user_id_foreign")

  @@map("refresh_tokens")
}

model ApiKey {
  id         BigInt   @id @default(autoincrement())
  user_id    BigInt
  name       String
  key        String   @unique(map: "api_keys_key_unique")
  created_at DateTime @db.Timestamp(0)
  updated_at DateTime @db.Timestamp(0)
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "api_keys_user_id_foreign")

  @@map("api_keys")
}

model Tier {
  id          BigInt     @id @default(autoincrement())
  order_rank  Int?       @default(autoincrement())
  name        String     @unique(map: "tiers_key_unique")
  max_devices Int?
  created_at  DateTime   @db.Timestamp(0)
  updated_at  DateTime   @db.Timestamp(0)
  userTiers   UserTier[]

  @@map("tiers")
}

model UserTier {
  id         BigInt   @id @default(autoincrement())
  user_id    BigInt
  tier_id    BigInt
  created_at DateTime @db.Timestamp(0)
  updated_at DateTime @db.Timestamp(0)
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "user_tier_user_id_foreign")
  tier       Tier     @relation(fields: [tier_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "user_tier_tier_id_foreign")

  @@map("user_tier")
}
